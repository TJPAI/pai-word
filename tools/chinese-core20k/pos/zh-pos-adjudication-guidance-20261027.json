  "principles": [
    {
      "id": "P1",
      "rule": "POS must be supported by independent syntactic distribution of the headword as a word; a morpheme inside another word is not standalone evidence."
    },
    {
      "id": "P2",
      "rule": "NUM+CLF sequences are annotated as constructions unless a documented lexicalized analysis and segmentation standard justify whole-string POS."
    },
    {
      "id": "P3",
      "rule": "Measure-unit nouns and classifiers are separated by a declared consistent tagset; mere numeral adjacency does not establish CLF."
    },
    {
      "id": "P4",
      "rule": "Adverbial syntactic position of a location noun does not by itself create lexical ADV POS."
    },
    {
      "id": "P5",
      "rule": "Attested sense, register, independent minimal pairs and evidence provenance are required before changing any uncertain POS label."
    }
  ],

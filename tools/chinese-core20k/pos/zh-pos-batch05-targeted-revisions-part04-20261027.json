      "prior_primary": null,
      "prior_other": [],
      "proposed_primary": "NOUN",
      "proposed_other": [
        "ADJ"
      ],
      "evidence_zh": "“保持精神”“振奋精神”中是抽象名词；“他今天很精神”可受程度副词修饰，表现形容词性质。",
      "limit_zh": "词义需区分精神状态与心理活动。",
      "status": "CHATGPT_EDITORIAL_UNCERTIFIED",
      "production_ready": false
    },
    {
      "term": "健康",

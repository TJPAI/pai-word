      "runtime_index": 693,
      "prior_primary": "ADJ",
      "prior_other": [],
      "proposed_primary": "ADJ",
      "proposed_other": [
        "NOUN"
      ],
      "evidence_zh": "“身体很健康”是形容词性谓语，“维护健康”是抽象名词宾语。",
      "limit_zh": "单一ADJ标签遗漏名词义。",
      "status": "CHATGPT_EDITORIAL_UNCERTIFIED",
      "production_ready": false
    },
    {
      "term": "开放",

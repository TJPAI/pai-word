      "prior_primary": "ADV",
      "prior_other": [],
      "proposed_primary": "ADV",
      "proposed_other": [
        "DET"
      ],
      "evidence_zh": "“另外再检查一次”为副词，“另外一个方案”为限定成分。",
      "limit_zh": "“另外”与“另一个”切分需统一，不简单视所有位置为ADV。",
      "status": "CHATGPT_EDITORIAL_UNCERTIFIED",
      "production_ready": false
    },
    {
      "term": "精神",

      "proposed_primary": "VERB",
      "proposed_other": [
        "NOUN"
      ],
      "evidence_zh": "“保证质量”为动词，“提供保证”是名词宾语。",
      "limit_zh": "分义项保留动名兼类，不把所有名物化看作独立词义。",
      "status": "CHATGPT_EDITORIAL_UNCERTIFIED",
      "production_ready": false
    },
    {
      "term": "重点",

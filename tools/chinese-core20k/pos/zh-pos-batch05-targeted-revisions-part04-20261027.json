      "runtime_index": 695,
      "prior_primary": "VERB",
      "prior_other": [],
      "proposed_primary": "VERB",
      "proposed_other": [
        "ADJ"
      ],
      "evidence_zh": "“开放校园”可作动词，“态度很开放”表现形容词性。",
      "limit_zh": "被动或结果状态不能一律算形容词，须按语境区分。",
      "status": "CHATGPT_EDITORIAL_UNCERTIFIED",
      "production_ready": false
    },
    {
      "term": "保证",

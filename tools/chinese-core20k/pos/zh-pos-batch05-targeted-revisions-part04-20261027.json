      "prior_primary": "ADV",
      "prior_other": [],
      "proposed_primary": "CCONJ",
      "proposed_other": [
        "ADV"
      ],
      "evidence_zh": "“方案可行，然而成本偏高”连接两个转折命题；句首亦有话语连接副词属性。",
      "limit_zh": "应区别句际连接功能与句内状语。",
      "status": "CHATGPT_EDITORIAL_UNCERTIFIED",
      "production_ready": false
    },
    {
      "term": "另外",
